{
  "$ref": "#/definitions/comics",
  "definitions": {
    "comics": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "publishedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "coverImage": {
          "type": "string"
        },
        "coverImageAlt": {
          "type": "string"
        },
        "panels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "image": {
                "type": "string"
              },
              "alt": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              }
            },
            "required": [
              "image",
              "alt"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "linkedinUrl": {
          "type": "string",
          "format": "uri"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "publishedDate",
        "panels"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}