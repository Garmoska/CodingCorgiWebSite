---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Coding Corgi',
  description = 'Learning materials and insights from a software development corgi'
} = Astro.props;

const fullTitle = title === 'Coding Corgi' ? title : `${title} | Coding Corgi`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/corgi2-short.png" />
    <link rel="apple-touch-icon" href="/corgi2-short.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="bg-white border-b border-gray-200">
      <nav class="container mx-auto px-4 py-5 flex items-center justify-between">
        <a href="/" class="inline-flex items-center gap-3 text-2xl font-bold text-gray-900 hover:text-corgi-orange transition-colors">
          <img src="/corgi2-short.png" alt="Coding Corgi" class="w-12 h-12 rounded-full object-cover" />
          Coding Corgi
        </a>
        <div class="flex items-center gap-6 text-base font-medium text-gray-700">
          <a href="/posts" class="hover:text-corgi-orange transition-colors">Posts</a>
          <a href="/comics" class="hover:text-corgi-orange transition-colors">Comics</a>
        </div>
      </nav>
    </header>

    <main class="flex-grow container mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="bg-gray-100 mt-12">
      <div class="container mx-auto px-4 py-6 text-center text-gray-600">
        <p>&copy; {new Date().getFullYear()} Coding Corgi. Built with Astro 🚀</p>
        <p class="text-sm mt-2">A corgi on a mission to teach software development, one wag at a time.</p>
      </div>
    </footer>
  </body>
</html>
