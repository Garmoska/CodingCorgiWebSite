---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  publishedDate: Date;
  slug: string;
  coverImage?: any;
  coverImageAlt?: string | undefined;
  linkedinUrl?: string | undefined;
  tags?: string[] | undefined;
}

const { title, description, publishedDate, slug, coverImage, coverImageAlt, linkedinUrl, tags } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(publishedDate);
---

<article class="bg-white border border-gray-200 rounded-lg shadow-md hover:shadow-lg transition-shadow overflow-hidden">
  <a href={`/posts/${slug}`} class="block group">
    {coverImage && (
      <div class="aspect-video w-full overflow-hidden">
        <Image
          src={coverImage}
          alt={coverImageAlt || title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          widths={[400, 600, 800]}
          sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 400px"
        />
      </div>
    )}
    <div class="p-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-2 group-hover:text-corgi-orange transition-colors">
        {title}
      </h2>
      <p class="text-gray-600 mb-4">{description}</p>
      <div class="flex items-center justify-between text-sm text-gray-500">
        <time datetime={publishedDate.toISOString()}>
          {formattedDate}
        </time>
        {linkedinUrl && (
          <a
            href={linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-600 hover:text-blue-800 flex items-center gap-1"
          >
            View on LinkedIn →
          </a>
        )}
      </div>
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map(tag => (
            <span class="bg-corgi-cream text-corgi-brown text-xs font-semibold px-3 py-1 rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>
