{
  "permissions": {
    "allow": [
      "Bash(npm --version)",
      "Bash(npm create *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git commit *)",
      "Bash(node scripts/new-post.mjs)",
      "Bash(echo \"EXIT: $?\")",
      "Bash([ -f \"post-$i.$ext\" ])",
      "Bash(mv post-__TRACKED_VAR__.__TRACKED_VAR__ post-00__TRACKED_VAR__.__TRACKED_VAR__)",
      "Bash(npx astro *)",
      "Bash(curl -sS -o /dev/null -w \"home %{http_code}\\\\n\" http://localhost:4321/)",
      "Bash(curl -sS -o /dev/null -w \"comics %{http_code}\\\\n\" http://localhost:4321/comics)",
      "Bash(curl -sS -o /dev/null -w \"deadline %{http_code}\\\\n\" http://localhost:4321/comics/deadline-corgi)",
      "Bash(curl -sS http://localhost:4321/comics)",
      "Bash(curl -sS http://localhost:4321/)",
      "Bash(curl -sS http://localhost:4321/comics/deadline-corgi)",
      "Bash(mkdir -p \"src/content/comics/_images/deadline-corgi\")",
      "Bash(cp \"comics/comic-001/panel-1.jpg\" \"src/content/comics/_images/deadline-corgi/panel-1.jpg\")",
      "Bash(cp \"comics/comic-001/panel-2.jpg\" \"src/content/comics/_images/deadline-corgi/panel-2.jpg\")",
      "Bash(cp \"comics/comic-001/panel-3.jpg\" \"src/content/comics/_images/deadline-corgi/panel-3.jpg\")",
      "Bash(cp \"comics/comic-001/panel-4.jpg\" \"src/content/comics/_images/deadline-corgi/panel-4.jpg\")",
      "mcp__webstorm__create_new_file"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "webstorm"
  ]
}
