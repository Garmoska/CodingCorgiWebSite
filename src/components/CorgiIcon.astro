---
interface Props {
  class?: string;
  size?: number | string;
}

const { class: className = '', size = '1em' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
>
  <!-- Corgi body (long and low) -->
  <ellipse cx="50" cy="62" rx="30" ry="15" fill="#D2691E"/>

  <!-- White chest/belly -->
  <ellipse cx="50" cy="68" rx="24" ry="8" fill="#FFF8DC"/>

  <!-- Corgi head -->
  <ellipse cx="50" cy="40" rx="20" ry="18" fill="#D2691E"/>

  <!-- White face marking (blaze) -->
  <path d="M 50 22 L 44 55 L 56 55 Z" fill="#FFF8DC"/>

  <!-- Left ear (pointy) -->
  <path d="M 34 30 L 28 12 L 42 26 Z" fill="#D2691E"/>
  <path d="M 34 28 L 31 18 L 39 26 Z" fill="#FFB380"/>

  <!-- Right ear (pointy) -->
  <path d="M 66 30 L 72 12 L 58 26 Z" fill="#D2691E"/>
  <path d="M 66 28 L 69 18 L 61 26 Z" fill="#FFB380"/>

  <!-- Left cheek marking -->
  <ellipse cx="38" cy="46" rx="6" ry="5" fill="#FFF8DC"/>

  <!-- Right cheek marking -->
  <ellipse cx="62" cy="46" rx="6" ry="5" fill="#FFF8DC"/>

  <!-- Snout -->
  <ellipse cx="50" cy="50" rx="7" ry="5" fill="#FFF8DC"/>

  <!-- Nose -->
  <ellipse cx="50" cy="48" rx="3" ry="2.5" fill="#2C1810"/>

  <!-- Mouth -->
  <path d="M 50 51 L 50 54 M 50 54 Q 46 56 44 54 M 50 54 Q 54 56 56 54"
        stroke="#2C1810" stroke-width="1.2" fill="none" stroke-linecap="round"/>

  <!-- Left eye -->
  <ellipse cx="42" cy="38" rx="2.8" ry="3.2" fill="#2C1810"/>
  <circle cx="43" cy="37" r="1" fill="#FFF"/>

  <!-- Right eye -->
  <ellipse cx="58" cy="38" rx="2.8" ry="3.2" fill="#2C1810"/>
  <circle cx="59" cy="37" r="1" fill="#FFF"/>

  <!-- Short legs (corgi characteristic - stubby!) -->
  <rect x="30" y="72" width="7" height="12" rx="3" fill="#D2691E"/>
  <rect x="42" y="74" width="7" height="10" rx="3" fill="#FFF8DC"/>
  <rect x="54" y="74" width="7" height="10" rx="3" fill="#FFF8DC"/>
  <rect x="66" y="72" width="7" height="12" rx="3" fill="#D2691E"/>

  <!-- Fluffy tail -->
  <ellipse cx="82" cy="55" rx="6" ry="8" fill="#D2691E" transform="rotate(-20 82 55)"/>
  <ellipse cx="83" cy="53" rx="3" ry="5" fill="#FFF8DC" transform="rotate(-20 83 53)"/>
</svg>
