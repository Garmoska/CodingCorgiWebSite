---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../components/Layout.astro';

export async function getStaticPaths() {
  const comics = await getCollection('comics');
  return comics.map((comic) => ({
    params: { slug: comic.slug },
    props: { comic },
  }));
}

interface Props {
  comic: CollectionEntry<'comics'>;
}

const { comic } = Astro.props;
const { Content } = await comic.render();
const { title, description, publishedDate, panels, linkedinUrl, tags } = comic.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishedDate);
---

<Layout title={title} description={description}>
  <article class="max-w-3xl mx-auto">
    <a href="/comics" class="inline-flex items-center gap-1 text-corgi-brown hover:text-corgi-orange text-sm font-medium mb-6">
      ← All comics
    </a>

    <header class="mb-8">
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">{title}</h1>
      <p class="text-lg text-gray-700 mb-4">{description}</p>
      <div class="flex flex-wrap items-center gap-4 text-gray-500 text-sm">
        <time datetime={publishedDate.toISOString()}>{formattedDate}</time>
        {linkedinUrl && (
          <a
            href={linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-600 hover:text-blue-800"
          >
            View on LinkedIn →
          </a>
        )}
      </div>
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map((tag) => (
            <span class="bg-corgi-cream text-corgi-brown text-xs font-semibold px-3 py-1 rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="flex flex-col gap-6 mb-10">
      {panels.map((panel, i) => (
        <figure class="rounded-lg overflow-hidden shadow-md bg-white">
          <button
            type="button"
            class="comic-panel-trigger block w-full"
            data-panel-index={i}
            aria-label={`Open panel ${i + 1} in full view`}
          >
            <Image
              src={panel.image}
              alt={panel.alt}
              class="w-full h-auto cursor-zoom-in"
              widths={[400, 800, 1200]}
              sizes="(max-width: 768px) 100vw, 800px"
            />
          </button>
          {panel.caption && (
            <figcaption class="p-4 text-center text-gray-700 italic">
              {panel.caption}
            </figcaption>
          )}
        </figure>
      ))}
    </div>

    <div class="prose text-lg text-gray-800">
      <Content />
    </div>
  </article>

  <div
    id="comic-lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Comic panel viewer"
  >
    <button
      type="button"
      id="comic-lightbox-close"
      class="absolute top-4 right-4 text-white text-3xl leading-none w-10 h-10 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20"
      aria-label="Close"
    >×</button>
    <button
      type="button"
      id="comic-lightbox-prev"
      class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-3xl leading-none w-12 h-12 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20"
      aria-label="Previous panel"
    >‹</button>
    <button
      type="button"
      id="comic-lightbox-next"
      class="absolute right-4 top-1/2 -translate-y-1/2 text-white text-3xl leading-none w-12 h-12 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20"
      aria-label="Next panel"
    >›</button>
    <img id="comic-lightbox-image" src="" alt="" class="max-w-full max-h-full object-contain" />
  </div>
</Layout>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>('.comic-panel-trigger');
  const lightbox = document.getElementById('comic-lightbox') as HTMLDivElement | null;
  const lightboxImg = document.getElementById('comic-lightbox-image') as HTMLImageElement | null;
  const closeBtn = document.getElementById('comic-lightbox-close');
  const prevBtn = document.getElementById('comic-lightbox-prev');
  const nextBtn = document.getElementById('comic-lightbox-next');

  if (lightbox && lightboxImg && triggers.length > 0) {
    const sources: { src: string; alt: string }[] = [];
    triggers.forEach((btn) => {
      const img = btn.querySelector('img');
      sources.push({ src: img?.currentSrc || img?.src || '', alt: img?.alt || '' });
    });

    let currentIndex = 0;

    function open(index: number) {
      currentIndex = index;
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = sources[currentIndex]!.src;
      lightboxImg.alt = sources[currentIndex]!.alt;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    }

    function step(delta: number) {
      currentIndex = (currentIndex + delta + sources.length) % sources.length;
      if (!lightboxImg) return;
      lightboxImg.src = sources[currentIndex]!.src;
      lightboxImg.alt = sources[currentIndex]!.alt;
    }

    triggers.forEach((btn, i) => {
      btn.addEventListener('click', () => open(i));
    });
    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => step(-1));
    nextBtn?.addEventListener('click', () => step(1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
  }
</script>
